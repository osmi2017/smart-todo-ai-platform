# ============================================================================
# Smart Todo AI — Mobile (Expo)
#
# Copie ce fichier en `.env` puis remplace HOST_IP par l'adresse IP LAN de la
# machine qui exécute docker-compose (commande : hostname -I). Un téléphone ne
# peut pas joindre "localhost" : il lui faut l'IP de la machine hôte.
# Aucune adresse n'est codée en dur dans le code : tout vient d'ici.
# ============================================================================
EXPO_PUBLIC_API_URL=http://HOST_IP:8000/api
EXPO_PUBLIC_WS_URL=ws://HOST_IP:8000
EXPO_PUBLIC_ML_URL=http://HOST_IP:5001
EXPO_PUBLIC_MEETING_SERVICE_URL=http://HOST_IP:4000